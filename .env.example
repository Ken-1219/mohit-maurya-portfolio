# Hero portrait. The image is NOT in this repo (see .gitignore).
#
# Local development, with the file sitting in /public:
#   NEXT_PUBLIC_PORTRAIT_URL=/mohit-portrait.jpg
#
# Deployed, pointing at wherever the image is hosted:
#   NEXT_PUBLIC_PORTRAIT_URL=https://your-host/portrait.jpg
#
# Leave it unset and the hero renders its approved no-portrait layout.
NEXT_PUBLIC_PORTRAIT_URL=
